<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Holopix" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/holo_bg</item>
        <item name="android:statusBarColor">@color/holo_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:navigationBarColor">@color/holo_bg</item>
    </style>
    <style name="Theme.Holopix.Screensaver" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
    <color name="holo_bg">#FFF8FAFD</color>
    <color name="holo_icon_bg">#FF0B1220</color>
</resources>
